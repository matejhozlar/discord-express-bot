{
  "name": "discord-express-bot-template",
  "version": "1.0.0",
  "description": "A production-ready template for a Discord bot with an Express web server.",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --ext js,json --exec \"node src/index.js\"",
    "start": "node src/index.js",
    "register:commands": "node scripts/register-commands.js"
  },
  "keywords": [
    "discord",
    "bot",
    "express",
    "template",
    "starter"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "@discordjs/builders": "^1.9.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.0"
  }
}
